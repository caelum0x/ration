bin/
data/
*.log
.env
.DS_Store
.ration-demo.pid

# Rust
services/ledger-core/target/
sdk/rust/ration-client/target/
**/*.proptest-regressions

# C
services/wal/*.o
services/wal/*.a
services/wal/test_wal
services/wal/bench_wal

# Go
pkg/pb/*.pb.go

# proto codegen tool cache
**/.protoc-cache/

# dev-only mTLS CA/certs generated by infra/dev-ca/generate-dev-ca.sh —
# never commit private keys, even dev-only throwaway ones.
infra/dev-ca/out/

# TLC's checkpoint/state-dump dir, written next to whichever .tla it ran
# against (e.g. docs/formal/) every time someone runs the model checker.
states/
tla2tools.jar

# Terraform: provider plugin caches/state are environment-specific and
# can contain sensitive plan output — never commit them.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# libFuzzer harness build artifacts and auto-generated corpus/crash
# findings (services/wal/fuzz) — the harness source is committed, its
# compiled binary and discovered corpus are local, regenerable outputs.
services/wal/fuzz/fuzz_frame_parse
services/wal/fuzz/fuzz_frame_parse.dSYM/
services/wal/fuzz/corpus/
services/wal/fuzz/crash-*
services/wal/fuzz/leak-*
services/wal/fuzz/oom-*
services/wal/fuzz/timeout-*

# chaosload is a dev-only test tool (scripts/chaos/kill-ledger-mid-write.sh)
# built on demand into a scratch workdir — never commit the compiled
# binary if someone builds it at the module root by hand.
services/gateway/chaosload
.gstack/

# Generated hackathon-submission demo video/recording (scripts/
# record-demo.sh + asciinema/agg/ffmpeg) — a real build artifact meant
# for the owner to upload to YouTube/Vimeo and link in the HackerEarth
# submission form, not source, so it's never committed here.
demo-video/
